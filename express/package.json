{
  "name": "@privatus-analytics/express",
  "version": "1.0.0",
  "description": "Privatus Analytics for Express: the cookieless tracking script tag, event and click attributes, page props and optional auto inject",
  "license": "MIT",
  "homepage": "https://privatusanalytics.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Privatus-Analytics/js.git",
    "directory": "express"
  },
  "bugs": {
    "url": "https://github.com/Privatus-Analytics/js/issues"
  },
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "express",
    "express-middleware",
    "middleware",
    "privatus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "express": ">=4.17"
  },
  "devDependencies": {
    "@privatus-analytics/html-core": "1.0.0",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "compression": "^1.8.0",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
