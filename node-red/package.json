    "directory": "node-red"
  },
  "bugs": {
    "url": "https://github.com/Privatus-Analytics/js/issues"
  },
  "keywords": [
    "node-red",
    "privatus",
    "privatus-analytics",
    "analytics",
    "web-analytics",
    "privacy",
    "cookieless",
