      "privatus-breakdown": "nodes/privatus-breakdown.js",
      "privatus-realtime": "nodes/privatus-realtime.js",
      "privatus-webhook": "nodes/privatus-webhook.js"
    }
  },
  "scripts": {
    "test": "vitest run",
