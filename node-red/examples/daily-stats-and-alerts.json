[
  {
    "id": "a1f0c0de00000001",
    "type": "tab",
    "label": "Privatus Analytics",
    "disabled": false,
    "info": "Posts yesterday's visitors and top pages every morning, shows live visitors on demand, and receives Privatus Analytics webhooks.\n\nOpen the Privatus Analytics config node and paste your API token. Then set your site id (pa_...) in the stats, breakdown and realtime nodes."
  },
  {
    "id": "a1f0c0de00000002",
    "type": "privatus-config",
    "name": "Privatus Analytics",
    "apiUrl": "https://privatusanalytics.com"
  },
  {
    "id": "a1f0c0de00000010",
    "type": "inject",
    "z": "a1f0c0de00000001",
    "name": "Every day at 08:00",
    "props": [],
    "repeat": "",
    "crontab": "00 08 * * *",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 80,
    "wires": [["a1f0c0de00000011"]]
  },
  {
    "id": "a1f0c0de00000011",
    "type": "privatus-stats",
    "z": "a1f0c0de00000001",
    "name": "Yesterday",
    "server": "a1f0c0de00000002",
    "site": "",
    "period": "yesterday",
    "from": "",
    "to": "",
    "compare": "previous_period",
    "x": 340,
    "y": 80,
    "wires": [["a1f0c0de00000012"]]
  },
  {
    "id": "a1f0c0de00000012",
    "type": "change",
    "z": "a1f0c0de00000001",
    "name": "Keep the numbers",
    "rules": [
      { "t": "set", "p": "stats", "pt": "msg", "to": "payload", "tot": "msg" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 530,
    "y": 80,
    "wires": [["a1f0c0de00000013"]]
  },
  {
    "id": "a1f0c0de00000013",
    "type": "privatus-breakdown",
    "z": "a1f0c0de00000001",
    "name": "Top 5 pages",
    "server": "a1f0c0de00000002",
    "site": "",
    "period": "yesterday",
    "from": "",
    "to": "",
    "compare": "none",
    "dimension": "page",
    "limit": "5",
    "x": 730,
    "y": 80,
    "wires": [["a1f0c0de00000014"]]
  },
  {
    "id": "a1f0c0de00000014",
    "type": "function",
    "z": "a1f0c0de00000001",
    "name": "Write the message",
    "func": "const m = msg.stats.metrics\nconst change = (msg.stats.change || {}).visitors\nconst trend = change === null || change === undefined ? '' : ` (${change > 0 ? '+' : ''}${change}%)`\nconst pages = msg.payload.rows.map((row, i) => `${i + 1}. ${row.value} (${row.pageviews} views)`).join('\\n')\nmsg.payload = `Yesterday: ${m.visitors} visitors${trend}, ${m.pageviews} pageviews.\\nTop pages:\\n${pages}`\nreturn msg",
    "outputs": 1,
    "x": 930,
    "y": 80,
    "wires": [["a1f0c0de00000015"]]
  },
  {
    "id": "a1f0c0de00000015",
    "type": "debug",
    "z": "a1f0c0de00000001",
    "name": "Send to Slack, email or chat here",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
