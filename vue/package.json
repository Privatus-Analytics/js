{
  "name": "@privatus/vue",
  "version": "0.1.0",
  "description": "Privatus Analytics for Vue 3: plugin, usePrivatus() and v-privatus-event",
  "license": "MIT",
  "homepage": "https://privatusanalytics.com",
  "keywords": ["analytics", "privacy", "cookieless", "vue", "privatus"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p . && tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@privatus/tracker": "^0.1.0"
  },
  "peerDependencies": { "vue": ">=3.2" },
  "devDependencies": { "vue": "^3.5.13",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
