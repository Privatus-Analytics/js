{
  "name": "@privatus-analytics/next",
  "version": "0.1.0",
  "description": "Privatus Analytics for Next.js: <PrivatusAnalytics /> component and usePrivatus() hook",
  "license": "MIT",
  "homepage": "https://privatusanalytics.com",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "nextjs",
    "privatus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@privatus-analytics/tracker": "^0.1.0"
  },
  "peerDependencies": {
    "next": ">=13.4",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
