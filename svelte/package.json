{
  "name": "@privatus/svelte",
  "version": "0.1.0",
  "description": "Privatus Analytics for Svelte and SvelteKit: use:privatus action and a handle hook",
  "license": "MIT",
  "homepage": "https://privatusanalytics.com",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "svelte",
    "privatus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@privatus/tracker": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": ">=3"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
